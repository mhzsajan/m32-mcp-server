# Midas M32 MCP Server - seeds for the persisted config file. Copy to .env and edit.
# On first boot these values are written to data/config.json. Later edits to
# this file are ignored: change the setting with m32_show_mode or edit the JSON.
M32_HOST=192.168.1.10
M32_PORT=10023
M32_CONFIG_PATH=./data/config.json

# Never put credentials here. This server uses no authentication or passwords.
